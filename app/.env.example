# ============================================================
# distribuidorasis — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase (public — safe to expose in frontend bundle) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# --- Supabase (secret — server/CLI use only, NEVER in frontend) ---
# Used by seed scripts, Supabase CLI, and future server functions.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- Contact Email (added by FEAT-4) ---
# CONTACT_EMAIL_TO=ventas@distribuidorasis.com.mx
# CONTACT_EMAIL_FROM=noreply@distribuidorasis.com.mx
# RESEND_API_KEY=<your-resend-api-key>

# --- WhatsApp CTA (added by FEAT-4) ---
